# Copy this file to .env and adjust values

# Ollama — runs natively on your machine, not in Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
POSTGRES_URL=postgresql://raguser:ragpassword@postgres:5432/ragdb

# Redis
REDIS_URL=redis://redis:6379/0

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_N_RERANK=5

# Open WebUI
WEBUI_SECRET_KEY=change-this-secret
