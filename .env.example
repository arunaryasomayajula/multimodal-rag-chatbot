# Copy this file to .env and adjust values

# Ollama — runs natively on your machine, not in Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── vLLM model instances ──────────────────────────────────────────────────────
# Start individual models:  docker compose --profile <qwen|llama|mistral> up -d
# Start all at once:        docker compose --profile gpu up -d

# Qwen3-4B  (~8 GB VRAM bfloat16, Apache-2.0, no token needed)
VLLM_QWEN_ENABLED=false
VLLM_QWEN_BASE_URL=http://vllm-qwen:8000/v1
VLLM_QWEN_API_KEY=none
VLLM_QWEN_MODEL=qwen3:4b

# Llama-3.2-3B  (~6 GB VRAM bfloat16, gated — accept licence + set HF_TOKEN)
# https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
VLLM_LLAMA_ENABLED=false
VLLM_LLAMA_BASE_URL=http://vllm-llama:8000/v1
VLLM_LLAMA_API_KEY=none
VLLM_LLAMA_MODEL=llama3.2:3b

# Mistral-7B  (~14 GB bfloat16 / ~7 GB float16, Apache-2.0, no token needed)
VLLM_MISTRAL_ENABLED=false
VLLM_MISTRAL_BASE_URL=http://vllm-mistral:8000/v1
VLLM_MISTRAL_API_KEY=none
VLLM_MISTRAL_MODEL=mistral:7b

# HuggingFace token — https://huggingface.co/settings/tokens
# Required only for Llama.  Leave blank for Qwen and Mistral.
HF_TOKEN=

# LM Studio / generic OpenAI-compatible endpoint (optional)
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_COMPAT_API_KEY=none
OPENAI_COMPAT_DEFAULT_MODEL=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
POSTGRES_URL=postgresql://raguser:ragpassword@postgres:5432/ragdb

# Redis
REDIS_URL=redis://redis:6379/0

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_N_RERANK=5

# Auth (generate JWT_SECRET with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Open WebUI
WEBUI_SECRET_KEY=change-this-secret
